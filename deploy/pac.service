# PAC as a background service: starts at boot, restarts if it ever stops.
# Put this at /etc/systemd/system/pac.service, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now pac

[Unit]
Description=Pagani Air Cargo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pac
# Runs from the 'current' release symlink (see deploy/migrate_to_releases.sh).
# Reference data ships inside each release; pilot data lives in shared/data,
# pointed to by PAC_DATA_DIR, so a deploy or rollback never touches it.
WorkingDirectory=/home/pac/pac-acars/current
Environment=PAC_PUBLIC=1
Environment=PAC_HOST=127.0.0.1
Environment=PAC_PORT=5050
Environment=PAC_DATA_DIR=/home/pac/pac-acars/shared/data
ExecStart=/home/pac/pac-acars/current/.venv/bin/python app.py
Restart=always
RestartSec=5
# a little hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
# only the shared pilot-data directory is writable at runtime; release dirs are read-only
ReadWritePaths=/home/pac/pac-acars/shared/data

[Install]
WantedBy=multi-user.target
