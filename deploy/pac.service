# PAC as a background service: starts at boot, restarts if it ever stops.
# Put this at /etc/systemd/system/pac.service, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now pac

[Unit]
Description=Pagani Air Cargo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pac
WorkingDirectory=/home/pac/pac-acars
Environment=PAC_PUBLIC=1
Environment=PAC_HOST=127.0.0.1
Environment=PAC_PORT=5050
ExecStart=/home/pac/pac-acars/.venv/bin/python app.py
Restart=always
RestartSec=5
# a little hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/pac/pac-acars/data

[Install]
WantedBy=multi-user.target
